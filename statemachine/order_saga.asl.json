{
  "Comment": "Order saga: reserve inventory, request payment from the provider and PAUSE until its signed webhook resumes the saga (task token, 120 s timeout), then COMPLETE and notify. On failure or timeout it compensates in reverse order: refund through the provider, release the stock, mark the order FAILED with a reason, notify.",
  "StartAt": "ReserveInventory",
  "States": {
    "ReserveInventory": {
      "Type": "Task",
      "Comment": "Lambda order-saga-reserve-inventory: decrements stock for every item in ONE DynamoDB transaction (all or nothing) and marks the order RESERVED. Throws OutOfStock if any item is short.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${reserve_inventory_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId"
        }
      },
      "ResultSelector": {
        "customerName.$": "$.Payload.customerName",
        "currency.$": "$.Payload.currency",
        "totalAmount.$": "$.Payload.totalAmount",
        "itemsSummary.$": "$.Payload.itemsSummary",
        "simulate.$": "$.Payload.simulate"
      },
      "ResultPath": "$.order",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "OutOfStock"
          ],
          "ResultPath": "$.error",
          "Next": "DescribeFailure"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "DescribeFailure"
        }
      ],
      "Next": "RequestPayment"
    },
    "RequestPayment": {
      "Type": "Task",
      "Comment": "Lambda order-saga-request-payment stores THIS task token on payment intent PI-<orderId> and asks DemoPay to charge (SQS, 2-5 s). The saga then waits: payment_webhook calls SendTaskSuccess (paid) or SendTaskFailure PaymentDeclined. No callback within 120 s -> States.Timeout -> MarkPaymentTimedOut. PaymentTransientError (payment_flaky) is retried 2 s, 4 s, 8 s; each retry gets a new token.",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${request_payment_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId",
          "simulate.$": "$.order.simulate",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "TimeoutSeconds": 120,
      "ResultPath": "$.payment",
      "Retry": [
        {
          "ErrorEquals": [
            "PaymentTransientError"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "MarkPaymentTimedOut"
        },
        {
          "ErrorEquals": [
            "PaymentDeclined"
          ],
          "ResultPath": "$.error",
          "Next": "RefundPayment"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "RefundPayment"
        }
      ],
      "Next": "MarkOrderCompleted"
    },
    "MarkPaymentTimedOut": {
      "Type": "Task",
      "Comment": "Direct DynamoDB UpdateItem (no Lambda): payment intent REQUESTED -> TIMED_OUT, ONLY if still REQUESTED. If the webhook captured the payment a moment earlier (SUCCEEDED), the condition fails and the saga continues to RefundPayment, which refunds it.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${payments_table_name}",
        "Key": {
          "paymentIntentId": {
            "S.$": "States.Format('PI-{}', $.orderId)"
          }
        },
        "UpdateExpression": "SET #s = :timedOut, timedOutAt = :now, updatedAt = :now",
        "ConditionExpression": "#s = :requested",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":timedOut": {
            "S": "TIMED_OUT"
          },
          ":requested": {
            "S": "REQUESTED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.timeoutMarkError",
          "Next": "DescribeTimeout"
        }
      ],
      "Next": "DescribeTimeout"
    },
    "DescribeTimeout": {
      "Type": "Pass",
      "Comment": "Replaces the raw States.Timeout error with a readable one, so the order's failureReason says 'payment timeout'.",
      "Result": {
        "Error": "PaymentTimeout",
        "Cause": "payment timeout - DemoPay did not confirm the payment within 120 s"
      },
      "ResultPath": "$.error",
      "Next": "RefundPayment"
    },
    "MarkOrderCompleted": {
      "Type": "Task",
      "Comment": "Direct DynamoDB UpdateItem integration (no Lambda): sets status COMPLETED and appends it to statusHistory. Reached only after the webhook confirmed the payment (SendTaskSuccess).",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${orders_table_name}",
        "Key": {
          "orderId": {
            "S.$": "$.orderId"
          }
        },
        "UpdateExpression": "SET #status = :status, updatedAt = :now, statusHistory = list_append(statusHistory, :entry)",
        "ConditionExpression": "attribute_exists(orderId)",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "COMPLETED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":entry": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "COMPLETED"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  },
                  "detail": {
                    "S.$": "States.Format('Order fulfilled - payment {} captured', $.payment.paymentId)"
                  }
                }
              }
            ]
          }
        }
      },
      "ResultPath": null,
      "Next": "NotifyCustomer",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "RefundPayment"
        }
      ]
    },
    "NotifyCustomer": {
      "Type": "Task",
      "Comment": "Direct SNS Publish integration (no Lambda): emails the order confirmation via the order-saga-notifications topic.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${notifications_topic_arn}",
        "Subject.$": "States.Format('Order {} is COMPLETED', $.orderId)",
        "Message.$": "States.Format('Hi {},\n\nGood news! Your order {} has been confirmed and is now COMPLETED.\n\nItems:\n{}\n\nTotal paid: {} {}\nPayment reference: {}\n\nThank you for shopping with Order Saga.', $.order.customerName, $.orderId, $.order.itemsSummary, $.order.currency, $.order.totalAmount, $.payment.paymentId)"
      },
      "ResultSelector": {
        "messageId.$": "$.MessageId"
      },
      "ResultPath": "$.notification",
      "Next": "OrderCompleted"
    },
    "OrderCompleted": {
      "Type": "Succeed",
      "Comment": "Saga finished successfully: stock reserved, payment captured, order COMPLETED, customer notified."
    },
    "RefundPayment": {
      "Type": "Task",
      "Comment": "COMPENSATION - Lambda order-saga-refund-payment: refunds any charge for this order through DemoPay's idempotent refund API (a no-op if nothing was charged) and marks the intent REFUNDED. An intent still REQUESTED is marked FAILED (abandoned), so a later charge is refunded by the webhook.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${refund_payment_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId"
        }
      },
      "ResultSelector": {
        "refunded.$": "$.Payload.refunded"
      },
      "ResultPath": "$.refund",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.refundError",
          "Next": "ReleaseInventory"
        }
      ],
      "Next": "ReleaseInventory"
    },
    "ReleaseInventory": {
      "Type": "Task",
      "Comment": "COMPENSATION - Lambda order-saga-release-inventory: gives back exactly the stock this order reserved. Idempotent, so retries can never double-release.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${release_inventory_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId"
        }
      },
      "ResultSelector": {
        "released.$": "$.Payload.released"
      },
      "ResultPath": "$.release",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.releaseError",
          "Next": "DescribeFailure"
        }
      ],
      "Next": "DescribeFailure"
    },
    "DescribeFailure": {
      "Type": "Pass",
      "QueryLanguage": "JSONata",
      "Comment": "Builds a readable failureReason such as 'PaymentDeclined: Card declined by issuer (simulated)' from the caught error. A Lambda error's Cause is a JSON string, so its errorMessage is extracted.",
      "Output": "{% $merge([$states.input, {'failureReason': $states.input.error.Error & ': ' & ($contains($states.input.error.Cause, 'errorMessage') ? $parse($states.input.error.Cause).errorMessage : $states.input.error.Cause)}]) %}",
      "Next": "MarkOrderFailed"
    },
    "MarkOrderFailed": {
      "Type": "Task",
      "Comment": "Direct DynamoDB UpdateItem integration (no Lambda): sets status FAILED and failureReason, and appends FAILED to statusHistory.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${orders_table_name}",
        "Key": {
          "orderId": {
            "S.$": "$.orderId"
          }
        },
        "UpdateExpression": "SET #status = :status, failureReason = :reason, updatedAt = :now, statusHistory = list_append(statusHistory, :entry)",
        "ConditionExpression": "attribute_exists(orderId)",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "FAILED"
          },
          ":reason": {
            "S.$": "$.failureReason"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":entry": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "FAILED"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  },
                  "detail": {
                    "S.$": "$.failureReason"
                  }
                }
              }
            ]
          }
        }
      },
      "ResultPath": null,
      "Next": "NotifyCustomerFailure"
    },
    "NotifyCustomerFailure": {
      "Type": "Task",
      "Comment": "Direct SNS Publish integration (no Lambda): tells the customer the order FAILED, why, and that any reserved stock was released and nothing was charged.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${notifications_topic_arn}",
        "Subject.$": "States.Format('Order {} FAILED: {}', $.orderId, $.error.Error)",
        "Message.$": "States.Format('Hello,\n\nUnfortunately your order {} could not be completed.\n\nReason: {}\n\nAny payment taken has been refunded to your DemoPay wallet, and any stock reserved for this order has been released back to inventory.\n\nSorry for the inconvenience - Order Saga.', $.orderId, $.failureReason)"
      },
      "ResultSelector": {
        "messageId.$": "$.MessageId"
      },
      "ResultPath": "$.notification",
      "Next": "OrderFailed"
    },
    "OrderFailed": {
      "Type": "Fail",
      "Comment": "Saga ended in failure after compensation. The execution shows as FAILED in the console, with the reason as its Cause.",
      "Error": "OrderFailed",
      "CausePath": "$.failureReason"
    }
  }
}
