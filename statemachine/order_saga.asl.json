{
  "Comment": "Order saga: reserve inventory, request payment from the provider and PAUSE until its signed webhook resumes the saga (task token, 120 s timeout), then FULFIL each order line on its own (inline Map). All lines delivered: COMPLETED. Some lines unavailable: refund just those lines, write them off, PARTIALLY_FULFILLED. None: refund and write off everything, FAILED. If payment fails or times out it compensates in reverse order: refund through the provider, release the stock, mark the order FAILED with a reason. Every outcome notifies the customer.",
  "StartAt": "ReserveInventory",
  "States": {
    "ReserveInventory": {
      "Type": "Task",
      "Comment": "Lambda order-saga-reserve-inventory: decrements stock for every item in ONE DynamoDB transaction (all or nothing) and marks the order RESERVED. Throws OutOfStock if any item is short.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${reserve_inventory_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId"
        }
      },
      "ResultSelector": {
        "customerName.$": "$.Payload.customerName",
        "currency.$": "$.Payload.currency",
        "totalAmount.$": "$.Payload.totalAmount",
        "itemsSummary.$": "$.Payload.itemsSummary",
        "simulate.$": "$.Payload.simulate",
        "lines.$": "$.Payload.lines"
      },
      "ResultPath": "$.order",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "OutOfStock"
          ],
          "ResultPath": "$.error",
          "Next": "DescribeFailure"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "DescribeFailure"
        }
      ],
      "Next": "RequestPayment"
    },
    "RequestPayment": {
      "Type": "Task",
      "Comment": "Lambda order-saga-request-payment stores THIS task token on payment intent PI-<orderId> and asks DemoPay to charge (SQS, 2-5 s). The saga then waits: payment_webhook calls SendTaskSuccess (paid) or SendTaskFailure PaymentDeclined. No callback within 120 s -> States.Timeout -> MarkPaymentTimedOut. PaymentTransientError (payment_flaky) is retried 2 s, 4 s, 8 s; each retry gets a new token.",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${request_payment_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId",
          "simulate.$": "$.order.simulate",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "TimeoutSeconds": 120,
      "ResultPath": "$.payment",
      "Retry": [
        {
          "ErrorEquals": [
            "PaymentTransientError"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.error",
          "Next": "MarkPaymentTimedOut"
        },
        {
          "ErrorEquals": [
            "PaymentDeclined"
          ],
          "ResultPath": "$.error",
          "Next": "RefundPayment"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "RefundPayment"
        }
      ],
      "Next": "FulfillItems"
    },
    "MarkPaymentTimedOut": {
      "Type": "Task",
      "Comment": "Direct DynamoDB UpdateItem (no Lambda): payment intent REQUESTED -> TIMED_OUT, ONLY if still REQUESTED. If the webhook captured the payment a moment earlier (SUCCEEDED), the condition fails and the saga continues to RefundPayment, which refunds it.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${payments_table_name}",
        "Key": {
          "paymentIntentId": {
            "S.$": "States.Format('PI-{}', $.orderId)"
          }
        },
        "UpdateExpression": "SET #s = :timedOut, timedOutAt = :now, updatedAt = :now",
        "ConditionExpression": "#s = :requested",
        "ExpressionAttributeNames": {
          "#s": "status"
        },
        "ExpressionAttributeValues": {
          ":timedOut": {
            "S": "TIMED_OUT"
          },
          ":requested": {
            "S": "REQUESTED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.timeoutMarkError",
          "Next": "DescribeTimeout"
        }
      ],
      "Next": "DescribeTimeout"
    },
    "DescribeTimeout": {
      "Type": "Pass",
      "Comment": "Replaces the raw States.Timeout error with a readable one, so the order's failureReason says 'payment timeout'.",
      "Result": {
        "Error": "PaymentTimeout",
        "Cause": "payment timeout - DemoPay did not confirm the payment within 120 s"
      },
      "ResultPath": "$.error",
      "Next": "RefundPayment"
    },
    "FulfillItems": {
      "Type": "Map",
      "Comment": "Inline Map, one iteration per order line (up to 5 at once): Lambda order-saga-fulfill-item picks the line (reserved -> sold). Each iteration catches its OWN errors and returns {lineId, status: FULFILLED | UNAVAILABLE, reason}, so one damaged item can never fail the whole Map or the order. Runs only after the payment succeeded; reservation before it stays all-or-nothing.",
      "ItemsPath": "$.order.lines",
      "ItemSelector": {
        "orderId.$": "$.orderId",
        "lineId.$": "$$.Map.Item.Value.lineId"
      },
      "MaxConcurrency": 5,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "FulfillItem",
        "States": {
          "FulfillItem": {
            "Type": "Task",
            "Comment": "Lambda order-saga-fulfill-item: ONE line, idempotent (a retry never moves stock twice). FulfillmentTransientError (transaction conflicts) is retried; ItemUnavailable is not.",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${fulfill_item_function_arn}",
              "Payload": {
                "orderId.$": "$.orderId",
                "lineId.$": "$.lineId"
              }
            },
            "ResultSelector": {
              "lineId.$": "$.Payload.lineId",
              "status.$": "$.Payload.status"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "FulfillmentTransientError"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              },
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "LineUnavailable"
              }
            ],
            "End": true
          },
          "LineUnavailable": {
            "Type": "Pass",
            "QueryLanguage": "JSONata",
            "Comment": "This line could not be fulfilled: report it (with the reason) instead of failing the Map.",
            "Output": "{% ( $cause := $states.input.error.Cause; $message := ($cause and $contains($cause, 'errorMessage')) ? $parse($cause).errorMessage : $cause; {'lineId': $states.input.lineId, 'status': 'UNAVAILABLE', 'error': $states.input.error.Error, 'reason': $message ? $message : $states.input.error.Error} ) %}",
            "End": true
          }
        }
      },
      "ResultPath": "$.lineResults",
      "Next": "SummarizeFulfillment"
    },
    "SummarizeFulfillment": {
      "Type": "Pass",
      "QueryLanguage": "JSONata",
      "Comment": "Counts the Map's results: how many lines were fulfilled, which were unavailable and why.",
      "Output": "{% ( $results := $states.input.lineResults; $unavailable := $results[status = 'UNAVAILABLE']; $merge([$states.input, {'fulfillment': {'lineCount': $count($results), 'fulfilledCount': $count($results[status = 'FULFILLED']), 'unavailableCount': $count($unavailable), 'unavailableLineIds': [$unavailable.lineId], 'unavailableLines': [$unavailable.{'lineId': lineId, 'reason': reason}]}}]) ) %}",
      "Next": "FulfillmentOutcome"
    },
    "FulfillmentOutcome": {
      "Type": "Choice",
      "Comment": "All lines delivered -> COMPLETED as before. No line delivered -> refund and write off all, FAILED. Otherwise -> partial refund, PARTIALLY_FULFILLED.",
      "Choices": [
        {
          "Variable": "$.fulfillment.unavailableCount",
          "NumericEquals": 0,
          "Next": "MarkOrderCompleted"
        },
        {
          "Variable": "$.fulfillment.fulfilledCount",
          "NumericEquals": 0,
          "Next": "RefundAllLines"
        }
      ],
      "Default": "PartialRefund"
    },
    "PartialRefund": {
      "Type": "Task",
      "Comment": "Lambda order-saga-refund-payment (lineIds mode): refunds ONLY the unavailable lines, each at the amount stored on the order when it was created. DemoPay refunds each line at most once and never above the charge (I7). No Catch on purpose: after its retries the execution FAILS here (alarm order-saga-refund-or-write-off-errors) and is REDRIVEN from this state once fixed; it is idempotent per line.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${refund_payment_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId",
          "lineIds.$": "$.fulfillment.unavailableLineIds"
        }
      },
      "ResultSelector": {
        "refundedAmount.$": "$.Payload.refundedAmount",
        "refundedItemsSummary.$": "$.Payload.refundedItemsSummary",
        "keptItemsSummary.$": "$.Payload.keptItemsSummary",
        "keptAmount.$": "$.Payload.keptAmount"
      },
      "ResultPath": "$.lineRefund",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WriteOffLines"
    },
    "WriteOffLines": {
      "Type": "Task",
      "Comment": "Lambda order-saga-write-off-lines: the unavailable lines' units go reserved -> writtenOff (NOT back on sale), with an audit record in order-saga-write-offs. No Catch on purpose: after its retries the execution FAILS here (alarm order-saga-refund-or-write-off-errors) and is REDRIVEN from this state once fixed; it is idempotent per line.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${write_off_lines_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId",
          "lines.$": "$.fulfillment.unavailableLines"
        }
      },
      "ResultSelector": {
        "unitsWrittenOff.$": "$.Payload.unitsWrittenOff"
      },
      "ResultPath": "$.writeOff",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Next": "MarkOrderPartiallyFulfilled"
    },
    "MarkOrderPartiallyFulfilled": {
      "Type": "Task",
      "Comment": "Direct DynamoDB UpdateItem (no Lambda): status PARTIALLY_FULFILLED, appended to statusHistory with what was delivered and refunded.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${orders_table_name}",
        "Key": {
          "orderId": {
            "S.$": "$.orderId"
          }
        },
        "UpdateExpression": "SET #status = :status, updatedAt = :now, statusHistory = list_append(statusHistory, :entry)",
        "ConditionExpression": "attribute_exists(orderId)",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "PARTIALLY_FULFILLED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":entry": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "PARTIALLY_FULFILLED"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  },
                  "detail": {
                    "S.$": "States.Format('{} of {} items delivered - {} {} refunded for the unavailable items', $.fulfillment.fulfilledCount, $.fulfillment.lineCount, $.order.currency, $.lineRefund.refundedAmount)"
                  }
                }
              }
            ]
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Next": "NotifyCustomerPartial"
    },
    "NotifyCustomerPartial": {
      "Type": "Task",
      "Comment": "Direct SNS Publish integration (no Lambda): tells the customer what was delivered, which items were refunded and how much.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${notifications_topic_arn}",
        "Subject.$": "States.Format('Order {} is PARTIALLY FULFILLED', $.orderId)",
        "Message.$": "States.Format('Hi {},\n\nYour order {} has been partly delivered. Some items were found damaged in our warehouse, so we refunded them.\n\nDelivered:\n{}\n\nRefunded (cancelled):\n{}\n\nRefunded to your DemoPay wallet: {} {}\nYou paid {} {} in total, so your net charge is {} {}.\n\nSorry for the inconvenience - Order Saga.', $.order.customerName, $.orderId, $.lineRefund.keptItemsSummary, $.lineRefund.refundedItemsSummary, $.order.currency, $.lineRefund.refundedAmount, $.order.currency, $.order.totalAmount, $.order.currency, $.lineRefund.keptAmount)"
      },
      "ResultSelector": {
        "messageId.$": "$.MessageId"
      },
      "ResultPath": "$.notification",
      "Next": "OrderPartiallyFulfilled"
    },
    "OrderPartiallyFulfilled": {
      "Type": "Succeed",
      "Comment": "Saga finished: the available lines were delivered, the unavailable ones refunded and written off, the customer notified."
    },
    "RefundAllLines": {
      "Type": "Task",
      "Comment": "Every line was unavailable: refunds every line (together, the whole charge: the intent becomes REFUNDED), through the same idempotent, capped line refunds. No Catch on purpose: after its retries the execution FAILS here (alarm order-saga-refund-or-write-off-errors) and is REDRIVEN from this state once fixed; it is idempotent per line.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${refund_payment_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId",
          "lineIds.$": "$.fulfillment.unavailableLineIds"
        }
      },
      "ResultSelector": {
        "refundedAmount.$": "$.Payload.refundedAmount",
        "refundedItemsSummary.$": "$.Payload.refundedItemsSummary",
        "keptItemsSummary.$": "$.Payload.keptItemsSummary",
        "keptAmount.$": "$.Payload.keptAmount"
      },
      "ResultPath": "$.lineRefund",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WriteOffAllLines"
    },
    "WriteOffAllLines": {
      "Type": "Task",
      "Comment": "Every line's units go reserved -> writtenOff, with audit records. No Catch on purpose: after its retries the execution FAILS here (alarm order-saga-refund-or-write-off-errors) and is REDRIVEN from this state once fixed; it is idempotent per line.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${write_off_lines_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId",
          "lines.$": "$.fulfillment.unavailableLines"
        }
      },
      "ResultSelector": {
        "unitsWrittenOff.$": "$.Payload.unitsWrittenOff"
      },
      "ResultPath": "$.writeOff",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2.0
        }
      ],
      "Next": "DescribeAllUnavailable"
    },
    "DescribeAllUnavailable": {
      "Type": "Pass",
      "QueryLanguage": "JSONata",
      "Comment": "Sets error AllItemsUnavailable and a readable failureReason, then joins the normal failure path (MarkOrderFailed, notify).",
      "Output": "{% $merge([$states.input, {'error': {'Error': 'AllItemsUnavailable', 'Cause': 'all items unavailable'}, 'failureReason': 'AllItemsUnavailable: all items unavailable - ' & $states.input.order.currency & ' ' & $states.input.lineRefund.refundedAmount & ' refunded to your DemoPay wallet and every line written off'}]) %}",
      "Next": "MarkOrderFailed"
    },
    "MarkOrderCompleted": {
      "Type": "Task",
      "Comment": "Direct DynamoDB UpdateItem integration (no Lambda): sets status COMPLETED and appends it to statusHistory. Reached only after the webhook confirmed the payment (SendTaskSuccess).",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${orders_table_name}",
        "Key": {
          "orderId": {
            "S.$": "$.orderId"
          }
        },
        "UpdateExpression": "SET #status = :status, updatedAt = :now, statusHistory = list_append(statusHistory, :entry)",
        "ConditionExpression": "attribute_exists(orderId)",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "COMPLETED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":entry": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "COMPLETED"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  },
                  "detail": {
                    "S.$": "States.Format('Order fulfilled - payment {} captured', $.payment.paymentId)"
                  }
                }
              }
            ]
          }
        }
      },
      "ResultPath": null,
      "Next": "NotifyCustomer",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "RefundPayment"
        }
      ]
    },
    "NotifyCustomer": {
      "Type": "Task",
      "Comment": "Direct SNS Publish integration (no Lambda): emails the order confirmation via the order-saga-notifications topic.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${notifications_topic_arn}",
        "Subject.$": "States.Format('Order {} is COMPLETED', $.orderId)",
        "Message.$": "States.Format('Hi {},\n\nGood news! Your order {} has been confirmed and is now COMPLETED.\n\nItems:\n{}\n\nTotal paid: {} {}\nPayment reference: {}\n\nThank you for shopping with Order Saga.', $.order.customerName, $.orderId, $.order.itemsSummary, $.order.currency, $.order.totalAmount, $.payment.paymentId)"
      },
      "ResultSelector": {
        "messageId.$": "$.MessageId"
      },
      "ResultPath": "$.notification",
      "Next": "OrderCompleted"
    },
    "OrderCompleted": {
      "Type": "Succeed",
      "Comment": "Saga finished successfully: stock reserved, payment captured, order COMPLETED, customer notified."
    },
    "RefundPayment": {
      "Type": "Task",
      "Comment": "COMPENSATION - Lambda order-saga-refund-payment: refunds any charge for this order through DemoPay's idempotent refund API (a no-op if nothing was charged) and marks the intent REFUNDED. An intent still REQUESTED is marked FAILED (abandoned), so a later charge is refunded by the webhook.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${refund_payment_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId"
        }
      },
      "ResultSelector": {
        "refunded.$": "$.Payload.refunded"
      },
      "ResultPath": "$.refund",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.refundError",
          "Next": "ReleaseInventory"
        }
      ],
      "Next": "ReleaseInventory"
    },
    "ReleaseInventory": {
      "Type": "Task",
      "Comment": "COMPENSATION - Lambda order-saga-release-inventory: gives back exactly the stock this order reserved. Idempotent, so retries can never double-release.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${release_inventory_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId"
        }
      },
      "ResultSelector": {
        "released.$": "$.Payload.released"
      },
      "ResultPath": "$.release",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.releaseError",
          "Next": "DescribeFailure"
        }
      ],
      "Next": "DescribeFailure"
    },
    "DescribeFailure": {
      "Type": "Pass",
      "QueryLanguage": "JSONata",
      "Comment": "Builds a readable failureReason such as 'PaymentDeclined: Card declined by issuer (simulated)' from the caught error. A Lambda error's Cause is a JSON string, so its errorMessage is extracted.",
      "Output": "{% $merge([$states.input, {'failureReason': $states.input.error.Error & ': ' & ($contains($states.input.error.Cause, 'errorMessage') ? $parse($states.input.error.Cause).errorMessage : $states.input.error.Cause)}]) %}",
      "Next": "MarkOrderFailed"
    },
    "MarkOrderFailed": {
      "Type": "Task",
      "Comment": "Direct DynamoDB UpdateItem integration (no Lambda): sets status FAILED and failureReason, and appends FAILED to statusHistory.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${orders_table_name}",
        "Key": {
          "orderId": {
            "S.$": "$.orderId"
          }
        },
        "UpdateExpression": "SET #status = :status, failureReason = :reason, updatedAt = :now, statusHistory = list_append(statusHistory, :entry)",
        "ConditionExpression": "attribute_exists(orderId)",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "FAILED"
          },
          ":reason": {
            "S.$": "$.failureReason"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":entry": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "FAILED"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  },
                  "detail": {
                    "S.$": "$.failureReason"
                  }
                }
              }
            ]
          }
        }
      },
      "ResultPath": null,
      "Next": "NotifyCustomerFailure"
    },
    "NotifyCustomerFailure": {
      "Type": "Task",
      "Comment": "Direct SNS Publish integration (no Lambda): tells the customer the order FAILED, why, and that any payment was refunded.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${notifications_topic_arn}",
        "Subject.$": "States.Format('Order {} FAILED: {}', $.orderId, $.error.Error)",
        "Message.$": "States.Format('Hello,\n\nUnfortunately your order {} could not be completed.\n\nReason: {}\n\nAny payment taken has been refunded to your DemoPay wallet.\n\nSorry for the inconvenience - Order Saga.', $.orderId, $.failureReason)"
      },
      "ResultSelector": {
        "messageId.$": "$.MessageId"
      },
      "ResultPath": "$.notification",
      "Next": "OrderFailed"
    },
    "OrderFailed": {
      "Type": "Fail",
      "Comment": "Saga ended in failure after compensation. The execution shows as FAILED in the console, with the reason as its Cause.",
      "Error": "OrderFailed",
      "CausePath": "$.failureReason"
    }
  }
}
