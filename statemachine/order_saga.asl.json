{
  "Comment": "Order saga (happy path): reserve inventory, capture payment, mark the order COMPLETED and email the customer. Retries and compensation are added in Phase 2.",
  "StartAt": "ReserveInventory",
  "States": {
    "ReserveInventory": {
      "Type": "Task",
      "Comment": "Lambda order-saga-reserve-inventory: decrements stock for every item in ONE DynamoDB transaction (all or nothing) and marks the order RESERVED.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${reserve_inventory_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId"
        }
      },
      "ResultSelector": {
        "customerName.$": "$.Payload.customerName",
        "currency.$": "$.Payload.currency",
        "totalAmount.$": "$.Payload.totalAmount",
        "itemsSummary.$": "$.Payload.itemsSummary",
        "simulate.$": "$.Payload.simulate"
      },
      "ResultPath": "$.order",
      "Next": "ProcessPayment"
    },
    "ProcessPayment": {
      "Type": "Task",
      "Comment": "Lambda order-saga-process-payment: simulated payment capture; the order's simulate field selects the behaviour.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${process_payment_function_arn}",
        "Payload": {
          "orderId.$": "$.orderId",
          "amount.$": "$.order.totalAmount",
          "currency.$": "$.order.currency",
          "simulate.$": "$.order.simulate"
        }
      },
      "ResultSelector": {
        "paymentId.$": "$.Payload.paymentId",
        "status.$": "$.Payload.status"
      },
      "ResultPath": "$.payment",
      "Next": "MarkOrderCompleted"
    },
    "MarkOrderCompleted": {
      "Type": "Task",
      "Comment": "Direct DynamoDB UpdateItem integration (no Lambda): sets status COMPLETED and appends it to statusHistory.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${orders_table_name}",
        "Key": {
          "orderId": {
            "S.$": "$.orderId"
          }
        },
        "UpdateExpression": "SET #status = :status, updatedAt = :now, statusHistory = list_append(statusHistory, :entry)",
        "ConditionExpression": "attribute_exists(orderId)",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "COMPLETED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":entry": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "COMPLETED"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  },
                  "detail": {
                    "S.$": "States.Format('Order fulfilled - payment {} captured', $.payment.paymentId)"
                  }
                }
              }
            ]
          }
        }
      },
      "ResultPath": null,
      "Next": "NotifyCustomer"
    },
    "NotifyCustomer": {
      "Type": "Task",
      "Comment": "Direct SNS Publish integration (no Lambda): emails the order confirmation via the order-saga-notifications topic.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${notifications_topic_arn}",
        "Subject.$": "States.Format('Order {} is COMPLETED', $.orderId)",
        "Message.$": "States.Format('Hi {},\n\nGood news! Your order {} has been confirmed and is now COMPLETED.\n\nItems:\n{}\n\nTotal paid: {} {}\nPayment reference: {}\n\nThank you for shopping with Order Saga.', $.order.customerName, $.orderId, $.order.itemsSummary, $.order.currency, $.order.totalAmount, $.payment.paymentId)"
      },
      "ResultSelector": {
        "messageId.$": "$.MessageId"
      },
      "ResultPath": "$.notification",
      "Next": "OrderCompleted"
    },
    "OrderCompleted": {
      "Type": "Succeed",
      "Comment": "Saga finished successfully: stock reserved, payment captured, order COMPLETED, customer notified."
    }
  }
}
